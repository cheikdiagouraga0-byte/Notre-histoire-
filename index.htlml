<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pour ma petite préférée 💕</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: 'Georgia', serif;
    background: linear-gradient(135deg, #ff9a9e, #fad0c4, #fbc2eb);
    background-size: 400% 400%;
    animation: gradient 15s ease infinite;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    color: #fff;
    overflow-x: hidden;
    padding: 20px;
  }
  @keyframes gradient {
    0%,100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
  .card {
    background: rgba(255,255,255,0.18);
    backdrop-filter: blur(12px);
    border-radius: 25px;
    padding: 45px 35px;
    max-width: 620px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.25);
    border: 2px solid rgba(255,255,255,0.35);
  }
  h1 {
    font-size: 2.4em;
    margin-bottom: 15px;
    text-shadow: 2px 2px 8px rgba(0,0,0,0.25);
    line-height: 1.2;
  }
  .name {
    color: #fff0f5;
    font-style: italic;
  }
  .date {
    font-size: 1em;
    margin-bottom: 25px;
    opacity: 0.95;
    font-style: italic;
  }
  .photo {
    width: 200px;
    height: 200px;
    object-fit: cover;
    border-radius: 50%;
    border: 5px solid #fff;
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    margin: 10px auto 25px;
    display: block;
  }
  p {
    font-size: 1.15em;
    line-height: 1.7;
    margin-bottom: 18px;
  }
  .heart {
    font-size: 2.8em;
    animation: beat 1.2s infinite;
    display: inline-block;
    margin-bottom: 10px;
  }
  @keyframes beat {
    0%,100% { transform: scale(1); }
    50% { transform: scale(1.2); }
  }
  .compteur {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    margin: 25px 0;
  }
  .bloc {
    background: rgba(255,255,255,0.25);
    border-radius: 12px;
    padding: 12px 16px;
    min-width: 70px;
    border: 1px solid rgba(255,255,255,0.4);
  }
  .bloc .nb {
    font-size: 1.6em;
    font-weight: bold;
    display: block;
  }
  .bloc .lbl {
    font-size: 0.75em;
    opacity: 0.9;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .btn {
    display: inline-block;
    margin-top: 20px;
    padding: 14px 32px;
    background: #fff;
    color: #e75480;
    border-radius: 50px;
    text-decoration: none;
    font-weight: bold;
    font-size: 1.05em;
    transition: transform 0.3s;
    box-shadow: 0 10px 25px rgba(0,0,0,0.2);
    border: none;
    cursor: pointer;
    font-family: inherit;
  }
  .btn:hover { transform: scale(1.06); }
  .musique {
    margin-top: 25px;
    padding: 15px;
    background: rgba(255,255,255,0.15);
    border-radius: 15px;
    border: 1px solid rgba(255,255,255,0.3);
  }
  .musique p {
    font-size: 0.9em;
    margin-bottom: 10px;
    opacity: 0.95;
  }
  audio { width: 100%; margin-top: 5px; }
  @media (max-width: 500px) {
    h1 { font-size: 1.8em; }
    .photo { width: 150px; height: 150px; }
    .card { padding: 30px 20px; }
  }
</style>
</head>
<body>
  <div class="card">
    <div class="heart">💖</div>
    <h1>Pour ma petite préférée<br><span class="name">Kadidiatou Cissé</span></h1>
    <p class="date">Ensemble depuis le 28 avril 2026</p>

    <!-- Remplace "kadidiatou.jpg" par le nom de ta photo -->
    <img src="kadidiatou.jpg" alt="Ma petite préférée" class="photo">

    <!-- COMPTEUR AUTOMATIQUE -->
    <div class="compteur" id="compteur">
      <div class="bloc"><span class="nb" id="jours">0</span><span class="lbl">Jours</span></div>
      <div class="bloc"><span class="nb" id="heures">0</span><span class="lbl">Heures</span></div>
      <div class="bloc"><span class="nb" id="minutes">0</span><span class="lbl">Min</span></div>
      <div class="bloc"><span class="nb" id="secondes">0</span><span class="lbl">Sec</span></div>
    </div>

    <p>
      Ma petite préférée, tu comptes énormément pour moi. 
      Chaque jour à tes côtés est un cadeau que je chéris.
    </p>
    <p>
      Merci pour ton sourire, ta douceur et tous ces moments 
      qui rendent ma vie plus belle. Je t'aime ❤️
    </p>

    <button class="btn" onclick="surprise()">Clique ici 🎁</button>

    <!-- MUSIQUE -->
    <div class="musique">
      <p>🎵 Notre chanson : Victory - Dad Secte</p>
      <!-- Remplace "victory.mp3" par ton fichier -->
      <audio controls loop>
        <source src="victory.mp3" type="audio/mpeg">
        Ton navigateur ne supporte pas l'audio.
      </audio>
    </div>
  </div>

<script>
// ===== COMPTEUR AUTOMATIQUE =====
// Date mise à jour : 28 avril 2026
const debut = new Date("2026-04-28T00:00:00");

function majCompteur() {
  const maintenant = new Date();
  const diff = maintenant - debut;

  const sec = Math.floor(diff / 1000);
  const min = Math.floor(sec / 60);
  const h   = Math.floor(min / 60);
  const j   = Math.floor(h / 24);

  document.getElementById("jours").textContent = j;
  document.getElementById("heures").textContent = h % 24;
  document.getElementById("minutes").textContent = min % 60;
  document.getElementById("secondes").textContent = sec % 60;
}
setInterval(majCompteur, 1000);
majCompteur();

// ===== SURPRISE + PLUIE DE CŒURS =====
function surprise() {
  const msgs = [
    "Je t'aime 💕",
    "Tu es magnifique, Kadidiatou ✨",
    "Ma petite préférée pour toujours 🥰",
    "Mon cœur t'appartient ❤️",
    "Tu comptes énormément pour moi 💖"
  ];
  alert(msgs[Math.floor(Math.random()*msgs.length)]);

  for (let i = 0; i < 40; i++) {
    const heart = document.createElement('div');
    heart.textContent = ['❤️','💕','💖','💗'][Math.floor(Math.random()*4)];
    heart.style.position = 'fixed';
    heart.style.left = Math.random()*100 + 'vw';
    heart.style.top = '-50px';
    heart.style.fontSize = (Math.random()*25+15) + 'px';
    heart.style.pointerEvents = 'none';
    heart.style.zIndex = '9999';
    heart.style.transition = 'transform 4s linear, opacity 4s';
    document.body.appendChild(heart);
    setTimeout(() => {
      heart.style.transform = `translateY(110vh) rotate(${Math.random()*720-360}deg)`;
      heart.style.opacity = 0;
    }, 50);
    setTimeout(() => heart.remove(), 4200);
  }
}
</script>
</body>
</html>
